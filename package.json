{
  "name": "orbite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "verifier": "node scripts/verifier-donnees.mjs && vite build && node scripts/test-mobile.mjs",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "node --test 'tests/*.test.mjs'",
    "secrets": "secretlint \"**/*\"",
    "audit": "npm audit --audit-level=high",
    "check": "node scripts/check.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "playwright": "1.63.0",
    "secretlint": "13.0.7",
    "vite": "8.3.7"
  }
}
